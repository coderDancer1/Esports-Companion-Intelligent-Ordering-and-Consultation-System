# ===== DeepSeek（经 Anthropic SDK 调用）=====
# 留空则使用内置 mock LLM，系统仍可完整运行（意图分类/摘要/画像抽取走确定性降级）
DEEPSEEK_API_KEY=
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== 存储 =====
# MySQL：留空或使用 sqlite 前缀则自动降级为 SQLite
MYSQL_URL=sqlite:///./data/app.db
# Redis：留空则使用进程内存实现
REDIS_URL=
# Chroma 持久化目录（未安装 chromadb 时使用内存向量库，忽略此路径）
CHROMA_PATH=./data/chroma

# ===== 向量 / 重排 =====
EMB_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# hash（默认，零依赖）| sentence_transformers（真实 BGE 模型）
EMBEDDING_BACKEND=hash
# HuggingFace 端点：默认直连 huggingface.co；国内可设 https://hf-mirror.com
HF_ENDPOINT=

# ===== 鉴权 =====
JWT_SECRET=dev-secret-change-me-in-prod
JWT_ALGORITHM=HS256
ADMIN_KEY=admin-dev-key

# ===== 压缩 =====
WINDOW_TOKENS=32000
COMPRESS_TRIGGER_RATIO=0.70
COMPRESS_KEEP_ROUNDS=3
COMPRESS_LOCK_TTL=60

# ===== RAG =====
RRF_K=60
RERANK_POOL=20
RERANK_TOP_K=5
# 重排阈值：jieba 词覆盖度降级用 RERANK_THRESHOLD；语义 CrossEncoder 用 RERANK_SEMANTIC_THRESHOLD
RERANK_THRESHOLD=0.35
RERANK_SEMANTIC_THRESHOLD=0.30

# ===== 意图 =====
HANDOFF_MAX=2
# 语义后端（sentence_transformers / BGE）阈值：余弦高，需高阈值
EMB_ABS_THRESHOLD=0.75
EMB_MARGIN=0.08
# 哈希后端阈值：hash 向量余弦上限约 0.5，需更低阈值（由 effective_backend 自动选择）
EMB_HASH_ABS_THRESHOLD=0.35
EMB_HASH_MARGIN=0.05
PROFILE_TTL=3600

# ===== 启动 =====
SEED_DEMO_DATA=true
